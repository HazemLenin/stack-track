# Copy to .env to override. Every value below is optional: compose and the API
# fall back to these local-only defaults. Never commit a real .env or real credentials.

# Postgres container (read by docker-compose.yml)
POSTGRES_USER=stacktrack
POSTGRES_PASSWORD=stacktrack
POSTGRES_DB=stacktrack
POSTGRES_PORT=5432

# API connection string. Overrides appsettings.Development.json when set as an
# environment variable (it is not read from .env by dotnet). For anything other
# than the local default, use `dotnet user-secrets` or the host's env vars.
# ConnectionStrings__Default=Host=localhost;Port=5432;Username=stacktrack;Password=stacktrack;Database=stacktrack
